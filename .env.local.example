# Required: Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: The Blue Alliance API key for live FRC data (https://www.thebluealliance.com/account)
# Without this, TBA data lookups will be unavailable but the AI will still work.
TBA_API_KEY=your_tba_api_key_here
